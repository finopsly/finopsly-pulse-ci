{
  "name": "finopsly-ci",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Install and cache the FinOpsly CLI for use in GitHub Actions workflows",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --minify --banner:js=\"import{createRequire as __cr}from 'module';const require=__cr(import.meta.url);\"",
    "lint": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.1.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
